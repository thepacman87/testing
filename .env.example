# Default PixForge generate is LOCAL (SD-Turbo sidecar). No API keys required.
# Start with: npm run ai   or   npm run dev

# Optional: sidecar URL (default http://127.0.0.1:8100)
# PIXFORGE_AI_URL=http://127.0.0.1:8100

# Optional: FAL only for Settings → Cloud edit upgrade (NOT used for default generate)
# FAL_KEY=

# Do not enable for default path
# ENABLE_EXTERNAL_GENERATE=false
