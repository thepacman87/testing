# PixForge needs NO environment variables for default mode.
# Text-to-image uses the free public Pollinations endpoint (no key).
# Matched photo edits run on-device via WASM.

# Optional: unlock Settings → Cloud upgrade (FAL FLUX Kontext)
# FAL_KEY=your_fal_api_key_here

# Optional: force cloud API route into mock responses
# MOCK_MODE=false
